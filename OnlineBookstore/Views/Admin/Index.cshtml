@{ ViewBag.Title = "Admin Dashboard"; }

<div class="container mt-4">
    <h2>👑 Admin Control Panel</h2>
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">Books</h3>
                </div>
                <div class="panel-body text-center">
                    <h2>@ViewBag.BookCount</h2>
                    @Html.ActionLink("Manage Books", "Books", "Admin", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title">Orders</h3>
                </div>
                <div class="panel-body text-center">
                    <h2>@ViewBag.OrderCount</h2>
                    @Html.ActionLink("View All Orders", "AllOrders", "Admin", null, new { @class = "btn btn-success" })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title">Users</h3>
                </div>
                <div class="panel-body text-center">
                    <h2>@ViewBag.UserCount</h2>
                    @Html.ActionLink("Manage Users", "Users", "Admin", null, new { @class = "btn btn-info" })
                </div>
            </div>
        </div>
    </div>
</div>