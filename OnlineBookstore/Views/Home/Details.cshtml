@model OnlineBookstore.Models.Book
@{
    ViewBag.Title = "Book Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            <img src="@Model.ImageUrl"
                 class="img-fluid rounded"
                 alt="@Model.Title"
                 style="box-shadow: 0 4px 8px rgba(0,0,0,0.1);"
                 onerror="this.src='https://via.placeholder.com/300x400?text=No+Image'" />
        </div>
        <div class="col-md-7">
            <h2>@Model.Title</h2>
            <p><strong>Author:</strong> @Model.Author</p>
            <p><strong>Category:</strong> @Model.Category.Name</p>
            <p><strong>Price:</strong> <span class="text-success">@Model.Price.ToString("C")</span></p>
            <p>
                <strong>Stock:</strong>
                <span class="@(Model.Stock > 0 ? "text-success" : "text-danger")">
                    @(Model.Stock > 0 ? $"{Model.Stock} in stock" : "Out of stock")
                </span>
            </p>
            <div class="mt-4">
                <h5>Description</h5>
                <p>@(string.IsNullOrEmpty(Model.Description) ? "No description available." : Model.Description)</p>
            </div>
            <div class="mt-4">
                @if (Model.Stock > 0)
                {
                    @Html.ActionLink("Add to Cart", "AddToCart", "Cart",
                        new { bookId = Model.BookId, quantity = 1 },
                        new { @class = "btn btn-primary btn-lg" })
                }
                else
                {
                    <span class="btn btn-secondary btn-lg disabled">Out of Stock</span>
                }
                @Html.ActionLink("Back to Catalog", "Index", "Home", null, new { @class = "btn btn-outline-secondary ms-2" })
            </div>
        </div>
    </div>
</div>