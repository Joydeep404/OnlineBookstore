@model List<OnlineBookstore.Models.Book>
@{
    ViewBag.Title = "Book Catalog";
}

<div class="container mt-4">
    <h2 class="mb-4">📚 Online Bookstore Catalog</h2>

    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong>Need help?</strong> Contact support at
        <a href="mailto:joydeep404@qq.com">joydeep404@qq.com</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Search & Filter Form -->
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "form-inline mb-3" }))
    {
        <div class="form-group mr-2">
            @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control", placeholder = "Search books..." })
        </div>
        <div class="form-group mr-2">
            @Html.DropDownList("categoryId",
                new SelectList(ViewBag.Categories as List<OnlineBookstore.Models.Category>, "CategoryId", "Name", ViewBag.SelectedCategory),
                "All Categories",
                new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary ml-2">Clear</a>
    }

    <!-- Book Grid -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning">No books found.</div>
    }
    else
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card card-book">
                        <a href="@Url.Action("Details", "Home", new { id = book.BookId })">
                            <img src="@book.ImageUrl"
                                 class="card-img-top"
                                 alt="@book.Title"
                                 style="height: 180px; width: 100%; object-fit: cover; cursor: pointer;"
                                 onerror="this.src='https://via.placeholder.com/150/990000/FFFFFF?text=No+Image'; this.onerror=null;" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @Html.ActionLink(book.Title, "Details", "Home", new { id = book.BookId }, new { @class = "text-decoration-none text-dark" })
                            </h5>
                            <p class="card-text text-muted small">by @book.Author</p>
                            <p class="@(book.Stock == 0 ? "text-danger font-weight-bold" : "")">
                                @book.Price.ToString("C") |
                                @(book.Stock > 0 ? $"{book.Stock} in stock" : "Out of stock")
                            </p>
                            <p class="mt-auto">
                                @if (book.Stock > 0)
                                {
                                    if (Session["UserId"] != null)
                                    {
                                        @Html.ActionLink("Add to Cart", "AddToCart", "Cart",
                                            new { bookId = book.BookId, quantity = 1 },
                                            new { @class = "btn btn-sm btn-primary" })
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-primary">Login to Add</a>
                                    }
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-secondary disabled">Out of Stock</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>